.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
*.Rproj

# Working material, never committed. Everything untracked lives here.
local_context/
CLAUDE.md

# Databases and build artefacts
*.duckdb
*.duckdb.wal
README.html

# Run logs, written by every pipeline pass. The folder is tracked, its contents are not.
log/*
!log/.gitkeep

# Benchmark output. The harness writes outside the repo by default; this covers
# a run that was pointed at the repo instead.
benchmark/results/
benchmark/*.csv

# Python arm
.venv/
__pycache__/
*.pyc
.pytest_cache/
